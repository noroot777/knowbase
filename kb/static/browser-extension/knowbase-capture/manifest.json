{
  "manifest_version": 3,
  "name": "Knowbase · 采集此页",
  "version": "1.0.0",
  "description": "由你主动读取当前文章，预览确认后补回本机 Knowbase 条目。不扫描其他标签，不读取 Cookie。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {"default_title": "采集此页到 Knowbase", "default_popup": "popup.html"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "预览当前页面正文"}}
}
